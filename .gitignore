# --- firered-gen9 ---
# Never commit a ROM: not the clean FireRed ROM, not a build, not a patched copy.
*.gba
*.GBA
*.agb
# upstream's multiboot images in data/ are not game ROMs
!/data/mb_*.gba
*.zip
*.7z
/roms/
